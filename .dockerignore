# ── Secrets — MUST NOT bake into any image layer ─────────────────────────────
.env
.env.*
# (cert and key are mounted at runtime; exclude any local copies under etc/)
etc/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/

# ── Frontend — the Node build stage installs deps + builds dist fresh, so the
# host's copies only bloat the build context (and must never leak into the image).
frontend/node_modules/
frontend/dist/

# ── Runtime data (mounted as volumes at runtime) ───────────────────────────────
data/
var/

# ── Git + VCS ─────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Eval artefacts (large, irrelevant to the container) ───────────────────────
evals/

# ── Dev / CI caches ───────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.pyc
__pycache__/
*.pyo

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── local agent / editor scratch dirs ───────────────────────────────────────────
.claude/
.superpowers/
.worktrees/

# ── Internal docs (all internal material lives under docs/dev/) ───────────────
docs/dev/

# ── Published-site-only doc assets ────────────────────────────────────────────
# The rest of docs/ IS copied into the image (the agent's system prompts are
# built from docs/OQL_PRIMER.md and docs/OQL_HUNT_EXAMPLES.md). These two
# subtrees are ~10 MB of screenshots and vendored guides that only the docs
# site renders and nothing reads at runtime. Anything a prompt reads must NOT
# live here; tests/test_image_layout.py replays these exclusions and fails if a
# declared prompt asset lands inside one.
docs/img/
docs/superpowers/
HANDOVER.md
FUTURE_IDEAS.md
ROADMAP.md
TODO.md

# ── Scripts not needed inside the image ───────────────────────────────────────
# Exception: the demo container's bundled mock ES (started by
# docker/demo-entrypoint.sh). NOTHING else from scripts/ may ship —
# scripts/build-public-mirror.sh in particular must never leave the dev tree.
scripts/
!scripts/demo/mock_es.py
!scripts/demo/demo_dataset.py

# ── Test suite ────────────────────────────────────────────────────────────────
tests/
