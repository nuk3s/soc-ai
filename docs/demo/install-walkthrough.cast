[35.506, "o", "\u001b[38;5;78m\u001b[1m✓ soc-ai is running.\u001b[0m\r\n"]
[35.806, "o", "    Open:     \u001b[38;5;81mhttps://192.0.2.10:8443/app\u001b[0m   (accept the self-signed cert on first visit)\r\n"]
