# soc-ai automated-install settings.
#
#   cp setup.conf.example setup.conf
#   $EDITOR setup.conf          # fill in the REQUIRED values below
#   ./setup.sh --auto           # installs with no prompts
#
# The format is KEY=value, one per line. setup.sh ignores a line that starts
# with #. It also ignores anything after a space-then-# on a value line. Quote a
# value that contains ` #`, as KEY='value'. A blank value falls back to the
# default shown.
# setup.conf holds secrets — it is chmod 600 and gitignored; keep it private.

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Security Onion URL
SO_HOST=https://your-so-grid
# SO analyst login. Elasticsearch uses the same login.
SO_USERNAME=analyst@example.com
# SO analyst password
SO_PASSWORD=
# your LiteLLM gateway
LITELLM_BASE_URL=http://localhost:4000
# a model your gateway serves. GET /v1/models lists them. REQUIRED for hunts to work.
ANALYST_MODEL=

# ── Connection details (sensible defaults) ────────────────────────────────────
# false for a self-signed Security Onion
SO_VERIFY_SSL=false
# Elasticsearch URL. Blank = <SO_HOST>:9200
ES_HOSTS=
ES_VERIFY_SSL=false
# gateway API key, if it requires one
LITELLM_API_KEY=
# false if the gateway uses a self-signed cert
LITELLM_VERIFY_SSL=true

# ── Grid-specific tuning (defaults fit most single-node grids) ────────────────
# What the triage queue counts as an alert. SO's own pipelines tag Suricata,
# Sigma, Wazuh and Strelka `tags:alert`; Elastic Defend endpoint alerts carry
# ECS `event.kind:alert` instead, so the default unions both. Narrow it (e.g.
# to event.dataset:suricata.alert) only after checking `soc-ai doctor`.
WEBUI_ALERTS_QUERY=tags:alert OR event.kind:alert
# Events live in SO 3.x `logs-*` data streams. setup.sh auto-detects the cluster
# prefix during its ES check and writes the concrete value; leave blank to accept
# that. Single-node = logs-* ; multi-node / distributed = *:logs-* .
# Keep the `logs-*` (data-stream name) form. The `.ds-…` form addresses hidden
# backing indices and forces you to list Elastic Agent namespaces — omit
# `.ds-logs-*-default-*` and system.auth/system.syslog vanish with no error.
EVENTS_INDEX_PATTERN=logs-*
# require a login or token for the API. Recommended.
API_AUTH_REQUIRED=true

# ── Secrets (leave blank to auto-generate; fill in to pin a value) ────────────
# Fernet key for encrypted secret overrides. Auto-generated if blank.
CONFIG_SECRET_KEY=
# first admin password. Auto-generated and printed if blank.
BOOTSTRAP_ADMIN_PASSWORD=

# ── TLS cert ──────────────────────────────────────────────────────────────────
# IP or DNS name for the self-signed cert SAN. Blank = this host's primary IP.
CERT_HOST=
